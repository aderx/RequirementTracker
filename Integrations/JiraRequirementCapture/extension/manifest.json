{
  "manifest_version": 3,
  "name": "Jira Requirement Capture",
  "description": "Capture Jira issues and GitLab merge requests into RequirementTracker.",
  "version": "1.16.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "记录 Jira / MR",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://jira.zstack.io/*",
        "*://gitlab.zstack.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://jira.zstack.io/*",
    "*://gitlab.zstack.io/*"
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "tabs"
  ]
}
